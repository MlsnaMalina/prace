# Zkopírujte tento soubor jako .env.local a doplňte skutečné hodnoty.
# Najdete je v Supabase dashboardu u projektu, který appka používá: Project Settings -> Data API (URL)
# a Project Settings -> API Keys (klíč označený "anon" / "public" / "publishable").
# Appka pracuje jen s tímto veřejným klíčem, nikdy s service_role/secret klíčem.

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Tlačítko HLEDEJ PRÁCI. Appka sama nic nestahuje — jen požádá GitHub Actions,
# ať spustí workflow `hledani.yml`.
#
# GITHUB_TOKEN je fine-grained personal access token s právem "Actions: Read and write"
# JEN na repozitář MlsnaMalina/prace. Nic jiného mu nedávejte.
#   GitHub -> Settings -> Developer settings -> Personal access tokens -> Fine-grained tokens
# Token nesmí nikdy skončit v gitu — patří do .env.local a do Vercelu (Environment Variables).
GITHUB_TOKEN=
GITHUB_REPO=MlsnaMalina/prace
